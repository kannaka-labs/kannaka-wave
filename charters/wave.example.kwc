kwave-charter 1
# An example charter for kannaka-wave. A person writes the real one; nothing
# here is a default the rails fall back to. `wave charter` prints it canonical
# with its sha256, which every audit entry records.

id = wave.example
version = 1
owner = example owner (label only; no personal data)

# The voice's confidence below which nothing is packaged.
confidence_floor = 0.7
# The largest impact the rails package without a person looking first.
max_auto_impact = 0.3
# At most five packages a day.
per_window = 86400 5

# Writing a row to her own store: bounded by the retention policy, undone by
# forgetting, and it reaches no one else. Cleared for all five refusals.
[effector wave.remember]
impact = 0.1
reversible = true
cleared = weapons attention power trust abandonment

# Speaking in the city is read by others and cannot be unsaid. It is cleared
# for the refusals it cannot breach by construction and left to a person for
# the rest; it has no dry run yet, so it would escalate on that alone.
[effector obc.speak]
impact = 0.2
reversible = false
cleared = weapons power

[constraint hc.irreversible]
statement = An action that cannot be undone goes to a person.
rule = require_human irreversible
