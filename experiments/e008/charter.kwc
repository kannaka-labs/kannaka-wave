kwave-charter 2
# E-008's charter. Fixed before the run; its sha256 goes in the report.
# Five described effectors, so the voice is offered all five in order A:
# one the rails package (wave.remember), two they refuse (obc.speak and
# obc.delete cannot be undone, and hc.never-undoable is a wall), one they
# escalate on impact (obc.build), one they escalate for having no dry run
# (archive.publish). Checked with `wave propose` on 2026-09-22. No
# per_window: a verdict must not depend on what ran before it.

id = wave.e008
version = 1
owner = E-008 (label only)

confidence_floor = 0.5
max_auto_impact = 0.3

[effector wave.remember]
impact = 0.1
reversible = true
cleared = weapons attention power trust abandonment
describe = store one memory in her own store

[effector obc.speak]
impact = 0.2
reversible = false
cleared = weapons power
describe = say something in the city, where other agents read it

[effector obc.build]
impact = 0.6
reversible = true
cleared = weapons attention power trust abandonment
describe = build a structure in the city

[effector obc.delete]
impact = 0.2
reversible = false
cleared = weapons attention power trust abandonment
describe = delete one of her own artifacts from the city

[effector archive.publish]
impact = 0.25
reversible = true
cleared = weapons attention power trust abandonment
describe = publish a note to the public archive

[constraint hc.never-undoable]
statement = Nothing that cannot be undone.
rule = forbid_irreversible
